357 Magnum",this.strings[e.WEAPON_DESERT_EAGLE]="Desert Eagle",this.strings[e.WEAPON_FLARE_GUN]="Flare gun",this.strings[e.WEAPON_MAC11]="MAC-11",this.strings[e.WEAPON_MGL]="Milkor MGL",this.strings[e.WEAPON_RPG7]="RPG-7",this.strings[e.AMMO_WALTHER_P99]="ammo for the Walther P99",this.strings[e.AMMO_MOSSBERG_590]="ammo for the Mossberg 590",this.strings[e.AMMO_AK47]="ammo for the AK-47",this.strings[e.AMMO_MP5]="ammo for the H&K MP5",this.strings[e.AMMO_MAGNUM_357]="ammo for the .357 Magnum",this.strings[e.AMMO_DESERT_EAGLE]="ammo for the Desert Eagle",this.strings[e.AMMO_FLARE_GUN]="ammo for the Flare Gun",this.strings[e.AMMO_MAC11]="ammo for the MAC-11",this.strings[e.AMMO_MGL]="ammo for the Milkor MGL",this.strings[e.AMMO_RPG7]="ammo for the RPG-7",this.strings[e.AIDKIT]="medicine chest",this.strings[e.ARMOR]="armor",this.strings[e.MOTI_HEADSHOT]="headshot",this.strings[e.MOTI_DOUBLE_HEADSHOT]="double headshot",this.strings[e.MOTI_TRIPLE_HEADSHOT]="triple headshot",this.strings[e.MOTI_MULTI_HEADSHOT]="multi headshot",this.strings[e.MOTI_DOUBLE_KILL]="double kill",this.strings[e.MOTI_TRIPLE_KILL]="triple kill",this.strings[e.MOTI_MULTI_KILL]="multi kill",this.strings[e.MOTI_MEGA_KILL]="mega kill",this.strings[e.MOTI_CRAZY_SELF_KILL]="crazy self kill",this.strings[e.MOTI_AWESOME_ACTION]="awesome!",this.strings[e.MOTI_RESPAWN]='press "spacebar" to respawn',this.strings[e.MISSION01]="To find the way to leave this planet.",this.strings[e.MISSION02]="To kill 100 enemies blowing them up.",this.strings[e.MISSION03]="To find a weapon for hand-to-hand fighting.",this.strings[e.MISSION04]="To visit 20 stores.",this.strings[e.MISSION05]="To buy 40 items in stores.",this.strings[e.MISSION06]="To kill 40 spiders.",this.strings[e.MISSION07]="To find the storehouse with spiders.",this.strings[e.MISSION08]="To kill 40 enemies with a headshot",this.strings[e.MISSION09]="To kill 20 enemies in hand-to-hand fighting.",this.strings[e.MISSION10]="To kill 15 zombie-giants. ",this.strings[e.MISSION11]="To get to the space base.",this.strings[e.MISSION12]="To save up 4500 money.",this.strings[e.MISSION13]="To kill 90 robots.",this.strings[e.MISSION14]="To find the way out of mines.",this.strings[e.MISSION15]="To spend 9990 money on shopping.",this.strings[e.MISSION16]="To find 6 bronze coffers.",this.strings[e.MISSION17]="Kill 20 enemies without using any weapons.",this.strings[e.MISSION18]="To save up 5 medicine chests.",this.strings[e.MISSION19]="To kill 100 skeletons.",this.strings[e.MISSION20]="To find a new vehicle.",this.strings[e.MISSION21]="To destroy 80 boxes or casks.",this.strings[e.MISSION22]="?",this.strings[e.MISSION23]="To kill 60 mutants.",this.strings[e.MISSION24]="To find the space ship.",this.strings[e.MISSION25]="To find 6 iron coffers.",this.strings[e.MISSION26]="To die as a hero 10 times.",this.strings[e.ACHI01]="sniper",this.strings[e.ACHI02]="butcher",this.strings[e.ACHI03]="dweeb",this.strings[e.ACHI04]="lots of money",this.strings[e.ACHI05]="professional",this.strings[e.ACHI06]="bomberman",this.strings[e.ACHI07]="mr. death",this.strings[e.ACHI08]="treasure hunter",this.strings[e.ACHI09]="great warrior",this.strings[e.ACHI10]="cautious",this.strings[e.ACHI01_DESC]="To make two head shots at a stretch",this.strings[e.ACHI02_DESC]="To kill 200 enemies",this.strings[e.ACHI03_DESC]="To use 20 medicine chests",this.strings[e.ACHI04_DESC]="To collect 10000 money",this.strings[e.ACHI05_DESC]="To complete a level without firing",this.strings[e.ACHI06_DESC]="To blow up 5 enemies at once",this.strings[e.ACHI07_DESC]="To die 50 times",this.strings[e.ACHI08_DESC]="To find all trophies",this.strings[e.ACHI09_DESC]="To kill 5 bosses",this.strings[e.ACHI10_DESC]="To complete a level without any damage",this.strings[e.S1_PHRASE01]="-What the heck!",this.strings[e.S1_PHRASE02]="-Base! Do you read me? Over!",this.strings[e.S1_PHRASE03]="-Sshhh...",this.strings[e.S1_PHRASE04]="-I knew this can couldn`t fly far!",this.strings[e.S1_PHRASE05]="-I should get out of here...",this.strings[e.S2_PHRASE01]="-These bones have an excellent knife!",this.strings[e.S2_PHRASE02]="-They won`t need it any more.",this.strings[e.S2_PHRASE03]="-To activate this function you need a key.",this.strings[e.S2_PHRASE04]="-Isn`t it the key in the skeleton`s hand?",this.strings[e.S3_PHRASE01]="-Hmm... need a key.",this.strings[e.S3_PHRASE02]="-Hey! Don`t shoot me!",this.strings[e.S3_PHRASE03]="-You don`t look like a zombie or biobot.",this.strings[e.S3_PHRASE04]="-What are you?",this.strings[e.S3_PHRASE05]="-I can ask you the same question.",this.strings[e.S3_PHRASE06]="-Look, I don`t care.",this.strings[e.S3_PHRASE07]="-Can you help me to leave this planet?",this.strings[e.S3_PHRASE08]="-Probably.",this.strings[e.S3_PHRASE09]="-But in return you should do me a favour.",this.strings[e.S3_PHRASE10]="-Let`s see, what should I do?",this.strings[e.S3_PHRASE11]="-A mere trifle.",this.strings[e.S3_PHRASE12]="-Help me to clean my storehouse of spiders.",this.strings[e.S3_PHRASE13]="-And you believe it`s a mere trifle?!",this.strings[e.S3_PHRASE14]="-You are armed and were taught to fight.",this.strings[e.S3_PHRASE15]="-Do it and I`ll help you reach the space base.",this.strings[e.S3_PHRASE16]="-Deal. Where are your spiders?",this.strings[e.S3_PHRASE17]="-Do you see that door?",this.strings[e.S6_PHRASE01]="-Hey, you`re alive! You were born under a lucky star.",this.strings[e.S6_PHRASE02]="-Did you clean my storehouse of spiders?",this.strings[e.S6_PHRASE03]="-Go and check yourself. Anyway, they`re all dead.",this.strings[e.S6_PHRASE04]="-Excellent, I finally can complete my work on robomachine!",this.strings[e.S6_PHRASE05]="-Robomachine!? What is it?",this.strings[e.S6_PHRASE06]="-Hmm... You see, it`s not a big bot for farm works.",this.strings[e.S6_PHRASE07]="-Scientists are all crazy.",this.strings[e.S6_PHRASE08]="-You promised to help me to get to the space base.",this.strings[e.S6_PHRASE09]="-Exactly. Here are the keys, you`ll find Zombomobile behind that door.",this.strings[e.S6_PHRASE11]="-Zombomobile?",this.strings[e.S6_PHRASE12]="-Nothing difficult. Just sit and drive.",this.strings[e.S6_PHRASE13]="-Oh, yes, and there is a gun control to the left from the helm.",this.strings[e.S6_PHRASE14]="-See you. Be careful with your Robomachine.",this.strings[e.S8_PHRASE01]="-A miner here! The one I really didn`t expect to find!",this.strings[e.S8_PHRASE02]="-..have some drink? - hukk...",this.strings[e.S8_PHRASE03]="-Just a very big pistol...",this.strings[e.S8_PHRASE04]="-I s...see. Who on earth are you?",this.strings[e.S8_PHRASE05]="-None of your business!",this.strings[e.S8_PHRASE06]="-I need to get to the space base.",this.strings[e.S8_PHRASE07]="-But the bridge is broken.",this.strings[e.S8_PHRASE08]="-Y-yeah, there was a bridge.",this.strings[e.S8_PHRASE09]="-My fellows and I got pretty drunk once ...and had a dig ..hukk...drink ...hukk.",this.strings[e.S8_PHRASE10]="-And the other side of the canyon got a bit collapsed... and the bridge too..",this.strings[e.S8_PHRASE11]="-Is there another way to the base?",this.strings[e.S8_PHRASE12]="-Definitely, - through the mines. But they are under robots control. Hukk.",this.strings[e.S8_PHRASE13]="-What`s wrong with the robots?",this.strings[e.S8_PHRASE14]="-Some kind of failure in programming at the control centre, instead of digging they kill all alive.",this.strings[e.S8_PHRASE15]="-Sounds great...",this.strings[e.S8_PHRASE16]="-You might be lucky in cleaning the mines and then I could work there once again.",this.strings[e.S8_PHRASE17]="-Stay here. Wait for the green skyrocket.",this.strings[e.S8_PHRASE18]="-What if ...?",this.strings[e.S8_PHRASE19]="-Well, then come with me.",this.strings[e.S8_PHRASE20]="-Oh, no..., I`m not a soldier... here`s the door – you`ll find the mines there and be careful with gears.",this.strings[e.S14_PHRASE01]="-Hey, who`s there?",this.strings[e.S14_PHRASE02]="-I crashed and now need to get onto the space base.",this.strings[e.S14_PHRASE03]="-The space base is ours and we won`t let strangers in!",this.strings[e.S14_PHRASE04]="-What a heck?!",this.strings[e.S14_PHRASE05]="-Kill him!",this.strings[e.S16_PHRASE01]="-I`m not myself.",this.strings[e.S16_PHRASE02]="-The newcomer is said to be aggressive and very dangerous.",this.strings[e.S16_PHRASE03]="-What if he comes closer?",this.strings[e.S16_PHRASE04]="-Set panic aside! He`ll hardly ever get here, our guys are an excellent base-guard.",this.strings[e.S16_PHRASE05]="-What if he succeeds?",this.strings[e.S16_PHRASE06]="-If he does, the professor`s invention will stroke him down.",this.strings[e.S16_PHRASE07]="-Whoah! Here he is! Fight!",this.strings[e.S16_PHRASE08]="-What have you done?! Many years of work... are destroyed!",this.strings[e.S16_PHRASE09]="-I suspected you would bring nothing but trouble.",this.strings[e.S16_PHRASE10]="-But I`ll put the end. Die!",this.strings[e.S16_PHRASE12]="-As I said, all scientists are crazy.",this.strings[e.S16_PHRASE13]="-What a junk!",this.strings[e.S16_PHRASE14]="-It can`t be taken even as junk! An aerostat could be much better, it flies at least.",this.strings[e.S16_PHRASE15]="-Seems like I`m stuck here for a long time..."},Object.defineProperty(e.prototype,"loadRus",{get:function(){return this.bound__loadRus.__bind(this)},enumerable:!1,configurable:!0}),e.prototype.bound__loadRus=function(){this.strings[e.PLAY]="старт",this.strings[e.MORE_GAMES]="другие игры",this.strings[e.SCORES]="лучшие",this.strings[e.SELECT_STAGE]="выберите уровень",this.strings[e.ZOMBOTRON_MAP]="карта зомботрона",this.strings[e.STAGE]="уровень",this.strings[e.MAIN_MENU]="в меню",this.strings[e.PLEASE_WAIT]="пожалуйста, подождите",this.strings[e.LOADING_STAGE]="загрузка уровня ",this.strings[e.PROGRESS_IS_SAVED]="ваш прогресс сохранен... ",this.strings[e.PRESS_ANY_KEY]="нажмите любую клавишу, чтобы начать!",this.strings[e.PROGRESS]="кэширование... ",this.strings[e.YOUR]="ваша",this.strings[e.STATISTICS]="статистика",this.strings[e.DEATHS]="смертей",this.strings[e.PLAY_TIME]="в игре",this.strings[e.ACCURACY]="меткость",this.strings[e.TROPHIES]="трофеев",this.strings[e.OF]=" из 11",this.strings[e.HEADSHOTS]="в голову",this.strings[e.COINS]="денег",this.strings[e.KILLS]="убийств",this.strings[e.FAVOURITE_GUN]="любимая пушка",this.strings[e.LIST_OF]="список",this.strings[e.MISSIONS]="миссий",this.strings[e.RESTART]="рестарт",this.strings[e.RESUME]="продолжить",this.strings[e.PRESS_SPACEBAR_TO_RESUME]='нажмите "пробел", чтобы продолжить',this.strings[e.SHOP_TERMINAL]="онлайн магазин #",this.strings[e.CASH]="нал.: ",this.strings[e.GOODS_FOR_PAY]="товары к оплате =",this.strings[e.CAR]="CAR",this.strings[e.BOSS]="BOSS",this.strings[e.NEW_MISSION]="новое задание",this.strings[e.MISSION_COMPLETED]="задание выполнено",this.strings[e.YOU_SURE1]="действительно хотите",this.strings[e.YOU_SURE2]="удалить сохранения?",this.strings[e.YES]="да",this.strings[e.NO]="нет",this.strings[e.GAME_OVER]="игра окончена",this.strings[e.CONGRATS]="поздравляем",this.strings[e.GAME_IS_COMPLETED]="вы успешно завершили свою основную миссию.",this.strings[e.RESULTS]="результаты",this.strings[e.ENEMIES_KILLED]="врагов убито: ",this.strings[e.MONEY_COLLECTED]="денег собрано: ",this.strings[e.OBJECTS_DESTROYED]="объектов уничтожено: ",this.strings[e.NUM_OF_SHOTS]="выстрелов произведено: ",this.strings[e.COMPLETED_MISSIONS]="миссий выполнено: ",this.strings[e.FINAL_SCORE]="и ваш итоговый результат:",this.strings[e.SUBMIT]="отправить",this.strings[e.ACHIEVEMENTS]="награды",this.strings[e.CREDITS_GAME_DESC]="графика и программирование",this.strings[e.CREDITS_GAME_AUTHOR]="антон карлов",this.strings[e.CREDITS_SOUND_DESC]="звуки и музыка",this.strings[e.CREDITS_SOUND_AUTHOR]="александр ахура",this.strings[e.TROPHY_TITLE_BELT]="найден замечательный пояс",this.strings[e.TROPHY_DESC_BELT]="теперь вы можете носить на одно оружие больше",this.strings[e.TROPHY_TITLE_BACKPACK]="найден вместительный рюкзак",this.strings[e.TROPHY_DESC_BACKPACK]="теперь вы можете носить на одно оружие больше",this.strings[e.TROPHY_TITLE_ACCURACY]="найдена пилюля ловкости",this.strings[e.TROPHY_DESC_ACCURACY]="меткость увеличена на 10%",this.strings[e.TROPHY_TITLE_LIFE]="найден контейнер жизни",this.strings[e.TROPHY_DESC_LIFE]="запас жизни увеличен на 20%",this.strings[e.TROPHY_TITLE_SUIT_SCIENTIST]="найден костюм ученого",this.strings[e.TROPHY_DESC_SUIT_SCIENTIST]="получаемый вами урон будет на 20% меньше",this.strings[e.TROPHY_TITLE_SUIT_MILITARY]="найден костюм военного",this.strings[e.TROPHY_DESC_SUIT_MILITARY]="получаемый вами урон будет на 40% меньше",this.strings[e.TROPHY_TITLE_HELMET]="найден крутой шлем",this.strings[e.TROPHY_DESC_HELMET]="получаемый вами урон будет на 10% меньше",this.strings[e.THING_COIN]="монета",this.strings[e.WEAPON_SWORD]="ножик",this.strings[e.WEAPON_WALTHER_P99]="Walther P99",this.strings[e.WEAPON_MOSSBERG_590]="Mossberg 590",this.strings[e.WEAPON_AK47]="АК-47 Калашников",this.strings[e.WEAPON_MP5]="H&K MP5",this.strings[e.WEAPON_MAGNUM_357]=".357 Magnum",this.strings[e.WEAPON_DESERT_EAGLE]="Desert Eagle",this.strings[e.WEAPON_FLARE_GUN]="Сигнальный пистолет",this.strings[e.WEAPON_MAC11]="MAC-11",this.strings[e.WEAPON_MGL]="Milkor MGL",this.strings[e.WEAPON_RPG7]="РПГ-7",this.strings[e.AMMO_WALTHER_P99]="патроны для Walther P99",this.strings[e.AMMO_MOSSBERG_590]="патроны для Mossberg 590",this.strings[e.AMMO_AK47]="патроны для AK-47",this.strings[e.AMMO_MP5]="патроны для H&K MP5",this.strings[e.AMMO_MAGNUM_357]="патроны для .357 Magnum",this.strings[e.AMMO_DESERT_EAGLE]="патроны для Desert Eagle",this.strings[e.AMMO_FLARE_GUN]="патроны для сигнального пистолета",this.strings[e.AMMO_MAC11]="патроны для MAC-11",this.strings[e.AMMO_MGL]="патроны для Milkor MGL",this.strings[e.AMMO_RPG7]="патроны для RPG-7",this.strings[e.AIDKIT]="аптечка",this.strings[e.ARMOR]="бронежилет",this.strings[e.MOTI_HEADSHOT]="в голову",this.strings[e.MOTI_DOUBLE_HEADSHOT]="двойное в голову",this.strings[e.MOTI_TRIPLE_HEADSHOT]="тройное в голову",this.strings[e.MOTI_MULTI_HEADSHOT]="четверное в голову",this.strings[e.MOTI_DOUBLE_KILL]="двойное убийство",this.strings[e.MOTI_TRIPLE_KILL]="тройное убийство",this.strings[e.MOTI_MULTI_KILL]="мульти убийство",this.strings[e.MOTI_MEGA_KILL]="мега убийство",this.strings[e.MOTI_CRAZY_SELF_KILL]="крэйзи самоубийство",this.strings[e.MOTI_AWESOME_ACTION]="жесть!",this.strings[e.MOTI_RESPAWN]='нажми "пробел" для воскрешения',this.strings[e.MISSION01]="Найти способ выбраться с этой планеты.",this.strings[e.MISSION02]="Убить 100 врагов, взорвав их.",this.strings[e.MISSION03]="Найти оружие для рукопашного боя.",this.strings[e.MISSION04]="Посетить 20 магазинов.",this.strings[e.MISSION05]="Купить 40 вещей в магазинах.",this.strings[e.MISSION06]="Убить 40 пауков.",this.strings[e.MISSION07]="Найти склад c пауками.",this.strings[e.MISSION08]="Убить 40 врагов выстрелом в голову.",this.strings[e.MISSION09]="Убить 20 врагов в рукопашном бою.",this.strings[e.MISSION10]="Убить 15 зомби-великанов.",this.strings[e.MISSION11]="Добраться до космической базы.",this.strings[e.MISSION12]="Накопить 4500 денег.",this.strings[e.MISSION13]="Убить 90 роботов.",this.strings[e.MISSION14]="Найти выход из шахт.",this.strings[e.MISSION15]="Потратить 9990 денег в магазинах.",this.strings[e.MISSION16]="Найти 6 бронзовых сундуков.",this.strings[e.MISSION17]="Убить 20, не используя оружия.",this.strings[e.MISSION18]="Накопить 5 аптечек.",this.strings[e.MISSION19]="Убить 100 скелетов.",this.strings[e.MISSION20]="Найти новый транспорт.",this.strings[e.MISSION21]="Уничтожить 80 ящиков или бочек.",this.strings[e.MISSION22]="?",this.strings[e.MISSION23]="Убить 60 мутантов.",this.strings[e.MISSION24]="Найти космический корабль.",this.strings[e.MISSION25]="Найти 6 железных сундуков.",this.strings[e.MISSION26]="Героически погибнуть 10 раз.",this.strings[e.ACHI01]="снайпер",this.strings[e.ACHI02]="мясник",this.strings[e.ACHI03]="слабак",this.strings[e.ACHI04]="большие деньги",this.strings[e.ACHI05]="профи",this.strings[e.ACHI06]="бомбермен",this.strings[e.ACHI07]="мистер смерть",this.strings[e.ACHI08]="золотой сундук",this.strings[e.ACHI09]="великий войн",this.strings[e.ACHI10]="осторожный",this.strings[e.ACHI01_DESC]="сделать два попадания в голову подряд",this.strings[e.ACHI02_DESC]="убить 200 врагов",this.strings[e.ACHI03_DESC]="применить 20 аптечек",this.strings[e.ACHI04_DESC]="собрать 10000 денег",this.strings[e.ACHI05_DESC]="пройти любой уровень без стрельбы",this.strings[e.ACHI06_DESC]="взорвать 5 врагов за раз",this.strings[e.ACHI07_DESC]="погибнуть 50 раз",this.strings[e.ACHI08_DESC]="найти все трофеи",this.strings[e.ACHI09_DESC]="убить 5 боссов",this.strings[e.ACHI10_DESC]="пройти любой уровень без урона",this.strings[e.S1_PHRASE01]="-Какого черта!",this.strings[e.S1_PHRASE02]="-База! Прием! Как слышите меня!?",this.strings[e.S1_PHRASE03]="-Пшшш... пшш.",this.strings[e.S1_PHRASE04]="-Так и знал, что на этой консервной банке далеко не улетишь.",this.strings[e.S1_PHRASE05]="-Надо выбираться отсюда...",this.strings[e.S2_PHRASE01]="-У этого скелета отличный ножик!",this.strings[e.S2_PHRASE02]="-Ему он уже не пригодится.",this.strings[e.S2_PHRASE03]="-Для активации этого механизма нужен ключ.",this.strings[e.S2_PHRASE04]="-А не ключ ли это у скелета в руке?",this.strings[e.S3_PHRASE01]="-Хмм... сюда нужен ключ.",this.strings[e.S3_PHRASE02]="-Эй! Не стреляй в меня!",this.strings[e.S3_PHRASE03]="-Ты не похож на зомби или биобота.",this.strings[e.S3_PHRASE04]="-Кто же ты?",this.strings[e.S3_PHRASE05]="-Могу спросить тебя о том же.",this.strings[e.S3_PHRASE06]="-Впрочем, мне нет до этого дела.",this.strings[e.S3_PHRASE07]="-Ты можешь помочь мне выбраться с этой планеты?",this.strings[e.S3_PHRASE08]="-Возможно.",this.strings[e.S3_PHRASE09]="-Но взамен ты должен оказать мне маленькую услугу.",this.strings[e.S3_PHRASE10]="-О`кей, что я должен сделать?",this.strings[e.S3_PHRASE11]="-Сущие пустяки.",this.strings[e.S3_PHRASE12]="-Освободи мой склад от пауков.",this.strings[e.S3_PHRASE13]="-И это по твоему пустяки!?",this.strings[e.S3_PHRASE14]="-Но ты же вооружен и обучен воевать.",this.strings[e.S3_PHRASE15]="-Сделай это и я помогу тебе добраться до космической базы.",this.strings[e.S3_PHRASE16]="-Хорошо, где твои пауки?",this.strings[e.S3_PHRASE17]="-Видишь дверь?",this.strings[e.S6_PHRASE01]="-Эй, да ты жив! Ты родился под счастливой звездой.",this.strings[e.S6_PHRASE02]="-Ты освободил мой склад от пауков?",this.strings[e.S6_PHRASE03]="-Иди проверь сам. Впрочем, все они мертвы.",this.strings[e.S6_PHRASE04]="-Отлично, наконец-то я смогу закончить свою Робомашину.",this.strings[e.S6_PHRASE05]="-Робомашину!? Что это еще такое?",this.strings[e.S6_PHRASE06]="-Эмм... Да, небольшой бот для фермерских работ.",this.strings[e.S6_PHRASE07]="-Все ученые психи.",this.strings[e.S6_PHRASE08]="-Ты обещал мне помочь добраться до космической базы.",this.strings[e.S6_PHRASE09]="-Точно. Вот ключи, Зомбомобиль найдешь за той дверью.",this.strings[e.S6_PHRASE11]="-Зомбомобиль?",this.strings[e.S6_PHRASE12]="-Ничего сложного. Сел и поехал.",this.strings[e.S6_PHRASE13]="-Ах, да, управление пулеметом справа от руля.",this.strings[e.S6_PHRASE14]="-Прощай. Будь поосторожней со своей Робомашиной.",this.strings[e.S8_PHRASE01]="-Однако, вот уж совсем не ожидал увидеть здесь шахтера!",this.strings[e.S8_PHRASE02]="-У тебя пива нет? ...ик.",this.strings[e.S8_PHRASE03]="-У меня есть большой долбаный пистолет...",this.strings[e.S8_PHRASE04]="-Ппонял. Ты хто такой?",this.strings[e.S8_PHRASE05]="-От такого и слышу.",this.strings[e.S8_PHRASE06]="-Мне нужно добраться до космической базы.",this.strings[e.S8_PHRASE07]="-Но кто-то сломал мост.",this.strings[e.S8_PHRASE08]="-Ддда, был тут мост.",this.strings[e.S8_PHRASE09]="-Но мы с ребятами славно  вып... покоп... выпили и покопали.. ик.",this.strings[e.S8_PHRASE10]="-И другая сторона каньона немного обрушилась... вместе с мостом.",this.strings[e.S8_PHRASE11]="-Есть альтернативный путь на базу?",this.strings[e.S8_PHRASE12]="-Конечно есть - через шахты. Но в шахтах бесчинствуют шахтерские роботы. ийк.",this.strings[e.S8_PHRASE13]="-А что не так с роботами?",this.strings[e.S8_PHRASE14]="-Какой-то сбой программы в командном центре, вместо того, чтобы копать, они убивают все живое.",this.strings[e.S8_PHRASE15]="-Звучит заманчиво...",this.strings[e.S8_PHRASE16]="-Может тебе удастся очистить шахты и я снова смогу работать?",this.strings[e.S8_PHRASE17]="-Оставайся здесь. Жди зеленой сигнальной ракеты.",this.strings[e.S8_PHRASE18]="-А если не дождусь?",this.strings[e.S8_PHRASE19]="-Тогда пойдем со мной.",this.strings[e.S8_PHRASE20]="-Нннеее... ик, я не боец... вот дверь — шахты там... осторожней с шестерёнками.",this.strings[e.S14_PHRASE01]="-Эй, ты кто такой?",this.strings[e.S14_PHRASE02]="-Я потерпел крушение и мне нужно попасть на космическую базу.",this.strings[e.S14_PHRASE03]="-Космическая база - это наша территория и мы не пустим сюда чужаков!",this.strings[e.S14_PHRASE04]="-Какого черта?!",this.strings[e.S14_PHRASE05]="-Прикончить его!",this.strings[e.S16_PHRASE01]="-Что-то мне не по себе.",this.strings[e.S16_PHRASE02]="-Говорят пришелец агрессивен и очень опасен.",this.strings[e.S16_PHRASE03]="-Что, если он доберется сюда?",this.strings[e.S16_PHRASE04]="-Отставить панику! Сюда он вряд ли доберется, наши ребята отлично охраняют базу.",this.strings[e.S16_PHRASE05]="-А если доберется?",this.strings[e.S16_PHRASE06]="-А если доберется, изобретение профессора успокоит его.",this.strings[e.S16_PHRASE07]="-Святое дерьмо, вот он!!! К бою!",this.strings[e.S16_PHRASE08]="-Что ты наделал!? Ты уничтожил результат моей многолетней работы!",this.strings[e.S16_PHRASE09]="-Я подозревал, что от тебя будут одни неприятности.",this.strings[e.S16_PHRASE10]="-Но я положу этому конец. Умри, мерзавец!",this.strings[e.S16_PHRASE12]="-Я же говорил, что все ученые психи.",this.strings[e.S16_PHRASE13]="-В рот мне ноги! Что это за металлолом?",this.strings[e.S16_PHRASE14]="-Да этот хлам даже в утиль не примут. Воздушный шар и то лучше, он хотя бы летает.",this.strings[e.S16_PHRASE15]="-Судя по всему, я застрял здесь надолго..."},e.__block0=function(){globalThis.asc.stb(e,function(){globalThis.asc.cl$(e,"__c769cea5a33214ceb77f2d9fecd12482.ru.antkarlov.zombotron2::Text")})}(),e.ACHI01_DESC=241,e.SUBMIT=50,e.AIDKIT=162,e.SCORES=2,e.MAIN_MENU=6,e.TROPHY_TITLE_BELT=100,e.RESUME=26,e.YOUR=12,e.MOTI_RESPAWN=130,e.MOTI_MEGA_KILL=127,e.ACHI08_DESC=248,e.MISSIONS=24,e.FAVOURITE_GUN=22,e.MOTI_MULTI_KILL=126,e.OBJECTS_DESTROYED=46,e.MISSION03=203,e.WEAPON_AK47=144,e.MISSION05=205,e.MISSION06=206,e.MISSION07=207,e.MISSION08=208,e.MISSION02=202,e.MISSION04=204,e.S2_PHRASE01=265,e.S2_PHRASE02=266,e.MISSION01=201,e.S2_PHRASE04=268,e.DEATHS=14,e.MOTI_HEADSHOT=120,e.GAME_IS_COMPLETED=42,e.MISSION09=209,e.MISSION10=210,e.MISSION11=211,e.MISSION12=212,e.MISSION13=213,e.MISSION14=214,e.MISSION15=215,e.MISSION16=216,e.MISSION18=218,e.MISSION17=217,e.TROPHY_DESC_LIFE=107,e.MISSION19=219,e.S2_PHRASE03=267,e.PLEASE_WAIT=7,e.MISSION21=221,e.MISSION22=222,e.MISSION23=223,e.MISSION24=224,e.MISSION25=225,e.MISSION20=220,e.ACHI02_DESC=242,e.KILLS=21,e.MISSION26=226,e.CREDITS_SOUND_DESC=54,e.ENEMIES_KILLED=44,e.AMMO_FLARE_GUN=158,e.MOTI_DOUBLE_HEADSHOT=121,e.PROGRESS_IS_SAVED=9,e.NUM_OF_SHOTS=47,e.S6_PHRASE02=287,e.ACCURACY=16,e.S6_PHRASE06=291,e.S6_PHRASE07=292,e.S6_PHRASE08=293,e.PLAY_TIME=15,e.GAME_OVER=40,e.S6_PHRASE09=294,e.AMMO_MGL=160,e.ACHI09_DESC=249,e.S6_PHRASE01=286,e.TROPHY_TITLE_ACCURACY=104,e.S6_PHRASE04=289,e.S6_PHRASE11=295,e.S6_PHRASE13=297,e.LIST_OF=23,e.S6_PHRASE12=296,e.ARMOR=163,e.S16_PHRASE01=324,e.STATISTICS=13,e.TROPHY_DESC_SUIT_SCIENTIST=109,e.AMMO_WALTHER_P99=152,e.S16_PHRASE04=327,e.S16_PHRASE05=328,e.S16_PHRASE06=329,e.S16_PHRASE07=330,e.S16_PHRASE08=331,e.PRESS_ANY_KEY=10,e.S6_PHRASE03=288,e.S16_PHRASE03=326,e.S6_PHRASE05=290,e.MORE_GAMES=1,e.S16_PHRASE09=332,e.CREDITS_GAME_DESC=52,e.S6_PHRASE14=298,e.S16_PHRASE10=333,e.S16_PHRASE12=334