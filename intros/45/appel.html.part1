  <script>
    const appElement = document.getElementById('app');
    const launchScreen = document.getElementById('launch');
    const loadingScreen = document.getElementById('loading');
    const loadingInner = document.getElementById('loading-inner');
    const errorScreen = document.getElementById('error');
    const errorScreenMessage = document.getElementById('error-message');
    const errorScreenStack = document.getElementById('error-stack');

    const handleError = (error) => {
      console.error(error);
      if (!errorScreen.hidden) return;
      errorScreen.hidden = false;
      errorScreenMessage.textContent = '' + error;
      let debug = error && error.stack || 'no stack';
      debug += '\nUser agent: ' + navigator.userAgent;
      errorScreenStack.textContent = debug;
    };
    const setProgress = (progress) => {
      if (loadingInner) loadingInner.style.width = progress * 100 + '%';
    };
    const interpolate = (a, b, t) => a + t * (b - a);

    try {
      setProgress(0.1);

      const scaffolding = new Scaffolding.Scaffolding();
      scaffolding.width = 480;
      scaffolding.height = 360;
      scaffolding.resizeMode = "preserve-ratio";
      scaffolding.editableLists = false;
      scaffolding.usePackagedRuntime = true;
      scaffolding.setup();
      scaffolding.appendTo(appElement);

      const vm = scaffolding.vm;
      window.scaffolding = scaffolding;
      window.vm = scaffolding.vm;
      window.Scratch = {
        vm,
        renderer: vm.renderer,
        audioEngine: vm.runtime.audioEngine,
        bitmapAdapter: vm.runtime.v2BitmapAdapter,
        videoProvider: vm.runtime.ioDevices.video.provider
      };

      scaffolding.setUsername("player####".replace(/#/g, () => Math.floor(Math.random() * 10)));
      scaffolding.setAccentColor("#efff14");

      try {
        scaffolding.addCloudProvider(new Scaffolding.Cloud.WebSocketProvider(["wss://clouddata.turbowarp.org","wss://clouddata.turbowarp.xyz"], "60917032"));
      } catch (error) {
        console.error(error);
      }

      vm.setTurboMode(false);
      if (vm.setInterpolation) vm.setInterpolation(false);
      if (vm.setFramerate) vm.setFramerate(30);
      if (vm.renderer.setUseHighQualityRender) vm.renderer.setUseHighQualityRender(false);
      if (vm.setRuntimeOptions) vm.setRuntimeOptions({
        fencing: true,
        miscLimits: true,
        maxClones: 300,
      });
      if (vm.setCompilerOptions) vm.setCompilerOptions({
        enabled: true,
        warpTimer: false
      });
      if (vm.renderer.setMaxTextureDimension) vm.renderer.setMaxTextureDimension(2048);

      // enforcePrivacy threat model only makes sense in the editor
      if (vm.runtime.setEnforcePrivacy) vm.runtime.setEnforcePrivacy(false);

      if (typeof ScaffoldingAddons !== 'undefined') {
        ScaffoldingAddons.run(scaffolding, {"gamepad":false,"pointerlock":false,"specialCloudBehaviors":false,"unsafeCloudBehaviors":false,"pause":false});
      }

      scaffolding.setExtensionSecurityManager({
        getSandboxMode: () => 'unsandboxed',
        canLoadExtensionFromProject: () => true
      });
      for (const extension of []) {
        vm.extensionManager.loadExtensionURL(extension);
      }

    } catch (e) {
      handleError(e);
    }
  </script>
  
  
      <script>
      const getBase85DecodeValue = (code) => {
        if (code === 0x28) code = 0x3c;
        if (code === 0x29) code = 0x3e;
        return code - 0x2a;
      };
      const base85decode = (str, outBuffer, outOffset) => {
        const view = new DataView(outBuffer, outOffset, Math.floor(str.length / 5 * 4));
        for (let i = 0, j = 0; i < str.length; i += 5, j += 4) {
          view.setUint32(j, (
            getBase85DecodeValue(str.charCodeAt(i + 4)) * 85 * 85 * 85 * 85 +
            getBase85DecodeValue(str.charCodeAt(i + 3)) * 85 * 85 * 85 +
            getBase85DecodeValue(str.charCodeAt(i + 2)) * 85 * 85 +
            getBase85DecodeValue(str.charCodeAt(i + 1)) * 85 +
            getBase85DecodeValue(str.charCodeAt(i))
          ), true);
        }
      };
      let projectDecodeBuffer = new ArrayBuffer(11821196);
      let projectDecodeIndex = 0;
      const decodeChunk = (size) => {
        try {
          if (document.currentScript.tagName.toUpperCase() !== 'SCRIPT') throw new Error('document.currentScript is not a script');
          base85decode(document.currentScript.getAttribute("data"), projectDecodeBuffer, projectDecodeIndex);
          document.currentScript.remove();
          projectDecodeIndex += size;
          setProgress(interpolate(0.1, 0.75, projectDecodeIndex / 11821193));
        } catch (e) {
          handleError(e);
        }
      };
      </script><script data="wC_B+4****2****ra;C0^5x)/68TbJSrA+*b*DlNwLKzIUF*2O]`T-gr\A=k6eCo76xc1D.Us)Zz{E8W?{aEDSk.=-,sgSjr|DK1xL4o6R-uXC6-a0,w\NkehzztaJ]:+f2z46b\)|_?Us+O.xX(Z{rc)nA(@L[^cPRl/|lnT_{nnA1sXvPPE-sXoINFk\b)K\Kv?3wj9p(]zHVq)6H@3Swh:F;\IxrhdV)fOx]{-9)lzK,(fH0qQqz-@,aI8LUkS|4jK1=d2Nmv6(Z,G^a,H6M(4Rq+8y.Q\f|.=Jj_H20VV-xn,_8y(]4RA7I@9g8=*z?bpXOy9[m=?dY,PulSON.8I\Bh=lu[Ng_mP41mu.IWCUXAx_,wjv6A8ckuvdsH31~0pODs_rd(OZ^z37}HDQt[[OLRGTG=z@J)6`X~lLhWFdYL+~3Bv^4H3eQK9^4-Gk]0\kHh4-Rddmw7qy~={Q+50[])j@LFb;v|xEa-*FhE3_i8@Le:aL[n51S+xID59ivLh8|VX49,t7Kja7pj(qf62wy@{}dFbYYwUwjJ4Pm1jBI3l_).RLR8g]bM]~yGS8H)(g:xN0kTOpiL+J]XU;Ky6K;sPFxLXErjD2zt4::OSz{BweJum9A~MCi)F~WPnX@3D^\ita?H^9xdY(yQERU;s|3kc6V77IA4avyeJ}2mf`6wnOU:2.pHax,xL/{Jf*6PLYXE,/=N,2|TYsmT(jTw]JnG`QZ9AZKA\=rnqqqxAv^w0L)dfD?dY6vFRiA:/CF\*9yNK=3e=JIA\[7,urEHh1/CyoCuIpk]vRc=ODj8j~o-If7|jifSHRd{VqsF8pd:row@xkHAQbjlQYoIe^PHBs5N=:D?H9|fB9ndU6W^q1h(a1s3zjbl2z{e|[oJ8-cFg4jf))YfY8lIE^asu;*yb_=@pS9I~f*8O^am0v?1/E9?Bjb_@jk{AzcWVr+/]CgfxIQH{@YapwOfFNG1gXJ|\e)i+PIz@fG9[gl6t6HfGK}9pn[dV?^@-+|u57yolFkuWsmj6Rb`a{|]1F0]Wo`|W1R9YZ1)|\zY9YkZe}3z_rwF,_e=Gabq3B?R`K)UYs_z2\OHoF?UJ4O/{yFs.jsK,R[s+NWnqjF.J/5,Nb*xp)j8:km;zp2zRED7?.Q-8O3FnfZZN)n1z\X[|zR.xjc.ja@qYYMHhe:/s2L}?G0n@H,Y|KO:tEi0C(z5{b.dMhk1~5}ATnd;SxGBfcY\oWCQrf]R)Q|Hf.`V.;ZinnHp5age-/uabL/2j_M,@n^GcP_^.Dqm|_jn=XJl4~rKh6`yy;bu=F\PloBQ-k(h.9,jD~+r?cZaUI==;~zL4T*p(@\HOb=AysOOfkjyD7Qi8InT^OEe~.Bhr(jWTjh1BNw`jQY@@gH{/KW,6pRsX+PiUx|k{~pm35@Nk2boQSfNa^PWs*O^l1VOX(1q`?M.SI_cL)QoG@x31lybHoEA@.voUmI{}ZNQ.,X5,[eS}Yl4~Xv}}CoR+583@D=50[ErI.X5}.EpkL8cohD;DrbGNiwsf_A|[48xRTV5H`}\0cyxospMh83:-KSq(]hY){84BxOx}41wyewCLb2)zqRxxHSN29H:DO0`xftd+6jXhZbyqAPOqCBdIo`STQy}X38;)Sq3wF:J/XVNWsNkp[;3(Jef6Xf~lB_dM4]_y-fw{i44Xu*jFzGIMIHV4@TC9Q]nQ*[iDXB~N:QNGhg3i]FBa6w.]j8pqpD:IYTr8aMFQK9t=|Za*NkWd(jRjG1MPhCwz=k8u5jgDOlQznc-r{yYu=X00iw@?*AJS{+z/We+.?PBuGaioJdDTKO0hG3VNRMOcB3E_(C)h\ZJyo}qs4]yO+hLIdEYj:phQyx5FY[YG.-BNoGN{+mX13LKd(K,\{y}DcKhhRFXlD1O:2OTgiqXw{COu)-+5EslZfS+{g{{1ZW0yjX@Qn}0\jRlBkGbIc2\[*)SSvxdCAz